# ─────────────────────────────────────────────────────────────────────────────
# Example environment file for local deploy / upload tooling.
#
# Copy to `.env` and fill in real values. NEVER commit `.env` — it is gitignored.
# Nothing in this repository reads a hardcoded secret; all credentials come from
# the environment (or, for interactive scripts, a getpass prompt).
#
#   cp .env.example .env
#   # then export them into your shell, e.g.:
#   set -a; source .env; set +a
# ─────────────────────────────────────────────────────────────────────────────

# ── deploy.py (bundle upload to the Contabo storage manager) ────────────────
# Long token issued by the storage VPS. Required only if the endpoint enforces auth.
DEPLOY_TOKEN=

# Optional: override the storage endpoint (defaults to https://storage.noahcohn.com).
CONTABO_BASE_URL=

# Optional: override the remote target folder (defaults to the project name, "rb338").
DEPLOY_FOLDER=

# ── SFTP tooling (e.g. scripts/rebirth_mod_upload.py) ───────────────────────
# Prefer key-based auth (SFTP_KEY_FILE) over a password whenever possible.
SFTP_HOST=storage.1ink.us
SFTP_USER=
# Provide EITHER a password OR (preferably) a private key path — not both.
SFTP_PASSWORD=
SFTP_KEY_FILE=
# Remote base directory that uploads are written under.
SFTP_REMOTE_BASE=
