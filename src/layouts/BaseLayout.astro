---
// BaseLayout.astro — shared shell for every page
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Community archive for the ReBirth RB-338 software synthesizer — songs, mods, and history preserved.',
} = Astro.props;

import { normalizeBase } from '../lib/url';
import { formatStatRange, totalSongsIndexed, totalMods, latestVersion } from '../data/archive-stats';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const base = normalizeBase(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <title>{title} — ReBirth RB-338 Archive</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet" />

    <!-- Global styles are imported via the component's style tag below -->
    <link rel="stylesheet" href={`${base}/styles/rebirth-theme.css`} />
    <slot name="head" />
  </head>
  <body class="rebirth-theme">
    <!-- Accessibility skip link -->
    <a href="#main-content" class="skip-nav">Skip to main content</a>

    <!-- Site header -->
    <header class="site-header rb-header">
      <div class="container">
        <a href={`${base}/`} class="site-logo rb-logo" aria-label="ReBirth RB-338 Archive home">
          <span class="logo-rb">RB</span>
          <span class="logo-338">-338</span>
          <span class="logo-sub">ARCHIVE</span>
        </a>

        <!-- Mobile toggle -->
        <button
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="rb-mobile-menu"
          class="rb-mobile-toggle"
          id="rb-mobile-toggle"
          type="button"
        >
          <span class="rb-mobile-toggle__bar"></span>
          <span class="rb-mobile-toggle__bar"></span>
          <span class="rb-mobile-toggle__bar"></span>
          <span class="rb-menu-label" style="margin-top:2px;">
            <span class="rb-menu-label__led" id="menu-led"></span>
            MENU
          </span>
        </button>

        <!-- Primary navigation -->
        <nav aria-label="Primary navigation" class="rb-nav rb-mobile-menu" id="rb-mobile-menu">
          <ul role="list">
            <li>
              <a
                href={`${base}/`}
                class={`rb-nav-btn${currentPath === '/' || currentPath === `${base}/` || currentPath === base ? ' is-active' : ''}`}
              >Home</a>
            </li>
            <li>
              <a
                href={`${base}/archive/songs`}
                class={`rb-nav-btn${currentPath.includes('/archive/songs') ? ' is-active' : ''}`}
              >Songs</a>
            </li>
            <li>
              <a
                href={`${base}/archive/mods`}
                class={`rb-nav-btn${currentPath.includes('/archive/mods') ? ' is-active' : ''}`}
              >Mods</a>
            </li>
            <li>
              <a
                href={`${base}/history`}
                class={`rb-nav-btn${currentPath.includes('/history') ? ' is-active' : ''}`}
              >History</a>
            </li>
            <li>
              <a
                href={`${base}/docs`}
                class={`rb-nav-btn${currentPath.includes('/docs') ? ' is-active' : ''}`}
              >Docs</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site footer -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <section class="footer-col" aria-labelledby="footer-archive-heading">
            <h2 id="footer-archive-heading" class="footer-heading">Archive</h2>
            <ul class="footer-links" role="list">
              <li><a href={`${base}/archive/songs`}>Browse Songs</a></li>
              <li><a href={`${base}/archive/mods`}>Browse Mods</a></li>
              <li><a href={`${base}/archive/songs?filter=artists`}>Featured Artists</a></li>
              <li><a href={`${base}/archive/mods#rawIndex`}>Complete Mod Index</a></li>
            </ul>
          </section>

          <section class="footer-col" aria-labelledby="footer-resources-heading">
            <h2 id="footer-resources-heading" class="footer-heading">Resources</h2>
            <ul class="footer-links" role="list">
              <li><a href={`${base}/history`}>History</a></li>
              <li><a href={`${base}/docs`}>Documentation</a></li>
              <li><a href="https://github.com/ford442/rebirth_website/issues/new?template=mod-metadata.yml" target="_blank" rel="noopener noreferrer">Contributing</a></li>
              <li><a href="https://github.com/ford442/rebirth_website" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
            </ul>
          </section>

          <section class="footer-col" aria-labelledby="footer-about-heading">
            <h2 id="footer-about-heading" class="footer-heading">About</h2>
            <p class="footer-about">
              ReBirth RB-338 is a virtual emulation of the Roland TB-303, TR-808, and TR-909 grooveboxes, originally released by Propellerhead Software.
            </p>
            <p class="footer-stats">
              {formatStatRange(totalSongsIndexed)} songs · {formatStatRange(totalMods)} mods · v{latestVersion}
            </p>
            <p class="footer-disclaimer">
              Community-maintained archive. Not affiliated with Propellerhead Software / Reason Studios.
            </p>
          </section>
        </div>
      </div>

      <div class="container footer-build-row">
        <p class="footer-build">
          Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> ·
          <a href="https://github.com/ford442/rebirth_website" target="_blank" rel="noopener noreferrer">Contribute on GitHub</a>
        </p>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      (function() {
        var toggle = document.getElementById('rb-mobile-toggle');
        var menu = document.getElementById('rb-mobile-menu');
        var led = document.getElementById('menu-led');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', function() {
          var isOpen = menu!.classList.toggle('is-open');
          toggle!.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          if (led) led.classList.toggle('is-on', isOpen);
        });
        // Close menu when clicking a nav link (mobile)
        menu.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', function() {
            menu!.classList.remove('is-open');
            toggle!.setAttribute('aria-expanded', 'false');
            if (led) led.classList.remove('is-on');
          });
        });
      })();
    </script>
  </body>
</html>

<style>
  /* ── Header — positional wrapper (visual via .rb-header) ──── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .rb-nav ul {
    display: flex;
    list-style: none;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .site-footer {
    border-top: 2px solid #111;
    padding-block: var(--space-lg);
    margin-top: var(--space-xl);
    background: linear-gradient(0deg, #111 0%, #1a1a1a 100%);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: left;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-heading {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rb-amber, #ffb000);
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--rb-amber, #ffb000);
    text-decoration: underline;
    outline: none;
  }

  .footer-about,
  .footer-stats,
  .footer-disclaimer {
    margin: 0;
    line-height: 1.5;
  }

  .footer-stats {
    font-family: var(--font-mono);
    color: var(--rb-green-bright, #3dba66);
  }

  .footer-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .footer-build-row {
    margin-top: 2.5rem;
    text-align: center;
  }

  .footer-build-row a {
    color: #999;
    text-decoration: none;
  }

  .footer-build-row a:hover {
    color: var(--rb-amber, #ffb000);
  }

  .footer-build { color: var(--color-text-muted); }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .footer-links a {
      min-height: 44px;
    }
  }
</style>
