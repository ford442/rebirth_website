---
// BaseLayout.astro — shared shell for every page
export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Community archive for the ReBirth RB-338 software synthesizer — songs, mods, and history preserved.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const normalizeBase = (value: string) => {
  const rawBase = value ?? '';
  if (rawBase === '/' || rawBase === '') return '';
  const trimmed = rawBase.replace(/\/+$/, '');
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};
const base = normalizeBase(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <title>{title} — ReBirth RB-338 Archive</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />

    <!-- Global styles are imported via the component's style tag below -->
    <link rel="stylesheet" href={`${base}/styles/rebirth-theme.css`} />
    <slot name="head" />
  </head>
  <body class="rebirth-theme">
    <!-- Accessibility skip link -->
    <a href="#main-content" class="skip-nav">Skip to main content</a>

    <!-- Site header -->
    <header class="site-header rb-header">
      <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding-block:.75rem;">
        <a href={`${base}/`} class="site-logo rb-logo" aria-label="ReBirth RB-338 Archive home">
          <span class="logo-rb">RB</span>
          <span class="logo-338">-338</span>
          <span class="logo-sub">ARCHIVE</span>
        </a>

        <!-- Mobile toggle -->
        <button
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="rb-mobile-menu"
          class="rb-mobile-toggle"
          id="rb-mobile-toggle"
          type="button"
        >
          <span class="rb-mobile-toggle__bar"></span>
          <span class="rb-mobile-toggle__bar"></span>
          <span class="rb-mobile-toggle__bar"></span>
          <span class="rb-menu-label" style="margin-top:2px;">
            <span class="rb-menu-label__led" id="menu-led"></span>
            MENU
          </span>
        </button>

        <!-- Primary navigation -->
        <nav aria-label="Primary navigation" class="rb-nav rb-mobile-menu" id="rb-mobile-menu">
          <ul role="list">
            <li>
              <a
                href={`${base}/`}
                class={`rb-nav-btn${currentPath === '/' || currentPath === `${base}/` || currentPath === base ? ' is-active' : ''}`}
              >Home</a>
            </li>
            <li>
              <a
                href={`${base}/archive/songs/index.html`}
                class={`rb-nav-btn${currentPath.includes('/archive/songs') ? ' is-active' : ''}`}
              >Songs</a>
            </li>
            <li>
              <a
                href={`${base}/archive/mods/index.html`}
                class={`rb-nav-btn${currentPath.includes('/archive/mods') ? ' is-active' : ''}`}
              >Mods</a>
            </li>
            <li>
              <a
                href={`${base}/docs`}
                class={`rb-nav-btn${currentPath.includes('/docs') ? ' is-active' : ''}`}
              >Docs</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site footer -->
    <footer class="site-footer">
      <div class="container">
        <p>
          ReBirth RB-338 Archive &mdash; Community-maintained. Not affiliated with Propellerhead Software.
        </p>
        <p class="footer-build">
          Built with <a href="https://astro.build" rel="noopener noreferrer" target="_blank">Astro</a> &mdash;
          <a href="https://github.com/ford442/rebirth_website" rel="noopener noreferrer" target="_blank">Contribute on GitHub</a>
        </p>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      (function() {
        var toggle = document.getElementById('rb-mobile-toggle');
        var menu = document.getElementById('rb-mobile-menu');
        var led = document.getElementById('menu-led');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', function() {
          var isOpen = menu.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          if (led) led.classList.toggle('is-on', isOpen);
        });
        // Close menu when clicking a nav link (mobile)
        menu.querySelectorAll('a').forEach(function(link) {
          link.addEventListener('click', function() {
            menu.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
            if (led) led.classList.remove('is-on');
          });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  /* ── Header — positional wrapper (visual via .rb-header) ──── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .rb-nav ul {
    display: flex;
    list-style: none;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding: 0;
    margin: 0;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  .site-footer {
    border-top: 2px solid #111;
    padding-block: var(--space-lg);
    margin-top: var(--space-xl);
    background: linear-gradient(0deg, #111 0%, #1a1a1a 100%);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .site-footer .container {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    align-items: center;
    text-align: center;
  }

  .site-footer a {
    color: #666;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--rb-amber, #ffb000);
  }

  .footer-build { opacity: 0.5; }
</style>
