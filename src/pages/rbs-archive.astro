---
// Redirect: /rbs-archive → /archive/songs
import BaseLayout from '../layouts/BaseLayout.astro';

const normalizeBase = (value: string) => {
  const rawBase = value ?? '';
  if (rawBase === '/' || rawBase === '') return '';
  const trimmed = rawBase.replace(/\/+$/, '');
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};
const base = normalizeBase(import.meta.env.BASE_URL);
const target = `${base}/archive/songs/index.html`;
---

<BaseLayout title="Redirecting…">
  <meta http-equiv="refresh" content={`0;url=${target}`} slot="head" />

  <div class="redirect-page">
    <div class="container">
      <div class="rb-panel">
        <div class="rb-panel__header">
          <span class="rb-panel__title">REDIRECT</span>
          <span class="rb-led rb-led--pending"><span class="rb-led__dot"></span>MOVED</span>
        </div>
        <div class="rb-panel__body" style="text-align:center;padding:2rem;">
          <p>The song archive has moved to a new location.</p>
          <p>
            <a class="rb-pattern-btn" href={target}>Go to Song Archive →</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .redirect-page {
    padding-block: 4rem;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .redirect-page .container {
    max-width: 500px;
    width: 100%;
  }

  .redirect-page p {
    color: #888;
    margin: 0 0 1rem;
  }
</style>
