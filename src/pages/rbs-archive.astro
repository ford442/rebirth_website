---
// Redirect: /rbs-archive → /archive/songs
import BaseLayout from '../layouts/BaseLayout.astro';
import HardwarePanel from '../components/ui/HardwarePanel.astro';
import ActionButton from '../components/ui/ActionButton.astro';

const normalizeBase = (value: string) => {
  const rawBase = value ?? '';
  if (rawBase === '/' || rawBase === '') return '';
  const trimmed = rawBase.replace(/\/+$/, '');
  return trimmed.startsWith('/') ? trimmed : `/${trimmed}`;
};
const base = normalizeBase(import.meta.env.BASE_URL);
const target = `${base}/archive/songs`;
---

<BaseLayout title="Redirecting…">
  <meta http-equiv="refresh" content={`0;url=${target}`} slot="head" />

  <div class="redirect-page">
    <div class="container">
      <HardwarePanel
        title="REDIRECT"
        ledStatus="pending"
        ledLabel="MOVED"
      >
        <p style="text-align:center;color:#888;margin:0 0 1rem;">The song archive has moved to a new location.</p>
        <p style="text-align:center;">
          <ActionButton variant="pattern" href={target}>Go to Song Archive →</ActionButton>
        </p>
      </HardwarePanel>
    </div>
  </div>
</BaseLayout>

<style>
  .redirect-page {
    padding-block: 4rem;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .redirect-page .container {
    max-width: 500px;
    width: 100%;
  }

  .redirect-page p {
    color: #888;
    margin: 0 0 1rem;
  }
</style>
