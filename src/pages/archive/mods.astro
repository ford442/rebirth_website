---
// src/pages/archive/mods.astro — Interactive RBM mods browser
import BaseLayout from '../../layouts/BaseLayout.astro';
import ModBrowserCard from '../../components/ModBrowserCard.astro';
import modsData from '../../data/mods-metadata.json';

const documentedMods = modsData.mods || [];
const totalDocumented = documentedMods.length;
---

<BaseLayout 
  title="RBM Mods Archive" 
  description="Browse and download ReBirth RB-338 RBM mod files from the community archive."
>

<div class="mods-page">
  <div class="container">

    <div class="rb-heading rb-heading-yellow">RBM Mods Archive</div>

    <!-- Header module -->
    <div class="mods-header rb-module">
      <div class="rb-module__header">
        <span class="rb-module__title">RBM MODS ARCHIVE</span>
        <span class="rb-led rb-led--online"><span class="rb-led__dot"></span>600+ FILES</span>
      </div>
      <div class="rb-module__body mods-header-body">
        <p class="mods-subtitle">Download custom ReBirth module modifications and skins</p>
        <p class="mods-info">Currently documenting {totalDocumented} of 600+ available mods. Missing metadata? <a href="https://github.com/ford442/rebirth_website" rel="noopener noreferrer" target="_blank">Contribute on GitHub →</a></p>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="mods-stats">
      <div class="rb-lcd" aria-label="Documented mods">
        <div class="lcd-label">DOCUMENTED</div>
        <div class="lcd-value">{totalDocumented}</div>
      </div>
      <div class="rb-lcd" aria-label="Total available">
        <div class="lcd-label">TOTAL</div>
        <div class="lcd-value">600<span class="lcd-unit">+</span></div>
      </div>
      <div class="rb-lcd" aria-label="Source">
        <div class="lcd-label">SOURCE</div>
        <div class="lcd-value">storage.1ink.us</div>
      </div>
      <div class="rb-lcd" aria-label="Status">
        <div class="lcd-label">STATUS</div>
        <div class="lcd-value">ACTIVE</div>
      </div>
    </div>

    <!-- Search & Filter -->
    <div class="search-filter-bar">
      <input
        type="text"
        id="modSearch"
        placeholder="Search by title, author, or tag..."
        class="rb-search-input"
        aria-label="Search mods"
      />
      <div class="filter-tags">
        <button class="tag-filter active" data-tag="" aria-label="Show all mods">All</button>
        <button class="tag-filter" data-tag="industrial" aria-label="Filter industrial mods">Industrial</button>
        <button class="tag-filter" data-tag="house" aria-label="Filter house mods">House</button>
        <button class="tag-filter" data-tag="dark" aria-label="Filter dark mods">Dark</button>
        <button class="tag-filter" data-tag="synth" aria-label="Filter synth mods">Synth</button>
        <button class="tag-filter" data-tag="official" aria-label="Filter official mods">Official</button>
      </div>
    </div>

    <!-- Mods grid -->
    <div id="modsGrid" class="mods-grid" role="main">
      {documentedMods.map((mod: any) => (
        <ModBrowserCard
          filename={mod.filename}
          title={mod.title}
          author={mod.author}
          year={mod.year}
          description={mod.description}
          tags={mod.tags}
        />
      ))}
    </div>

    <!-- Empty state -->
    <div id="emptyState" style="display:none" class="empty-state">
      <p>No mods match your search. Try different keywords or filters.</p>
    </div>

    <!-- Stats footer -->
    <div class="mods-footer">
      <p>Want to add documentation for a mod? <a href="https://github.com/ford442/rebirth_website/issues" rel="noopener noreferrer" target="_blank">Open an issue on GitHub</a> with the mod filename and details.</p>
    </div>

  </div>
</div>

</BaseLayout>

<style>
  .mods-page {
    padding-block: 2rem 4rem;
    background: #0f0f0f;
    min-height: 80vh;
  }

  .mods-header {
    margin-bottom: 1.5rem;
  }

  .mods-header-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mods-subtitle {
    font-size: 0.95rem;
    color: #aaa;
    margin: 0;
  }

  .mods-info {
    font-size: 0.8rem;
    color: #666;
    margin: 0;
  }

  .mods-info a {
    color: #ffb000;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .mods-info a:hover {
    color: #3dba66;
    text-decoration: underline;
  }

  .mods-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .lcd-unit {
    font-size: 0.6em;
    color: #b37800;
    margin-left: 1px;
  }

  .search-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .rb-search-input {
    padding: 0.6em 1em;
    background: #111;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    color: #c0c0c0;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 120ms ease;
  }

  .rb-search-input:focus {
    border-color: #ffb000;
    box-shadow: 0 0 0 2px rgba(255,176,0,0.15);
  }

  .rb-search-input::placeholder {
    color: #555;
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-filter {
    padding: 0.4em 0.8em;
    background: transparent;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    color: #888;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 120ms ease;
  }

  .tag-filter:hover {
    border-color: #ffb000;
    color: #ffb000;
  }

  .tag-filter.active {
    background: rgba(255,176,0,0.15);
    border-color: #ffb000;
    color: #ffb000;
  }

  .mods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: #666;
    font-size: 1rem;
  }

  .mods-footer {
    text-align: center;
    padding: 1.5rem;
    border-top: 1px solid #2a2a2a;
    border-radius: 6px;
    background: linear-gradient(180deg, #1e1e1e 0%, #151515 100%);
    font-size: 0.85rem;
    color: #666;
  }

  .mods-footer a {
    color: #ffb000;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .mods-footer a:hover {
    color: #3dba66;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .mods-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const modSearch = document.getElementById('modSearch');
  const tagFilters = document.querySelectorAll('.tag-filter');
  const emptyState = document.getElementById('emptyState');
  const modCards = document.querySelectorAll('.mod-card');

  function filterMods() {
    const searchTerm = modSearch?.value.toLowerCase() ?? '';
    const activeTag = document.querySelector('.tag-filter.active')?.getAttribute('data-tag') ?? '';
    
    let visibleCount = 0;

    modCards.forEach((card) => {
      const title = card.querySelector('.mod-card__title')?.textContent?.toLowerCase() ?? '';
      const author = card.querySelector('.mod-card__author')?.textContent?.toLowerCase() ?? '';
      const description = card.querySelector('.mod-card__description')?.textContent?.toLowerCase() ?? '';
      const tags = Array.from(card.querySelectorAll('.mod-tag')).map((t: any) => t.textContent.toLowerCase());
      
      const matchesSearch = !searchTerm || title.includes(searchTerm) || author.includes(searchTerm) || description.includes(searchTerm);
      const matchesTag = !activeTag || tags.includes(activeTag);
      
      const isVisible = matchesSearch && matchesTag;
      (card as HTMLElement).style.display = isVisible ? '' : 'none';
      
      if (isVisible) visibleCount++;
    });

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  if (modSearch) {
    modSearch.addEventListener('input', filterMods);
  }

  tagFilters.forEach((btn) => {
    btn.addEventListener('click', () => {
      tagFilters.forEach((b: any) => b.classList.remove('active'));
      btn.classList.add('active');
      filterMods();
    });
  });
</script>
