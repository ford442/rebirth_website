---
// Song Archive Browser — /archive/songs
import ArchivePageShell from '../../components/archive/ArchivePageShell.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import ArchiveEmptyState from '../../components/archive/ArchiveEmptyState.astro';
import HardwarePanel from '../../components/ui/HardwarePanel.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
import collectionsMeta from '../../data/collections-metadata.json';
import { normalizeBase } from '../../lib/url';
import { songCollections, archiveBaseUrl } from '../../data/song-collections';
import { normalizeArchiveUrl } from '../../lib/archive-urls';
import fullIndexRaw from '../../data/songs-full-index.json';
import {
  formatStatRange,
  totalSongsIndexed,
  mainCollectionCount,
  monthlyArchiveCount,
} from '../../data/archive-stats';
import artistsIndexRaw from '../../data/artists-index.json';
import ArchivePinControl from '../../components/ArchivePinControl.astro';

interface SongEntry {
  filename: string;
  url: string;
  title: string;
  collection: string;
  subcollection: string | null;
  artist: string | null;
  bpm: number | null;
  fileSize: string;
  source: string;
}

interface FullIndex {
  songs: SongEntry[];
  meta: {
    totalFiles: number;
    coveragePercent: number | null;
    source: string;
  };
}

const fullIndex = fullIndexRaw as unknown as FullIndex;
const allSongs = (fullIndex.songs || []).map((song) => ({
  ...song,
  url: normalizeArchiveUrl(song.url),
}));
const totalRaw = allSongs.length;
const coveragePercent = fullIndex.meta?.coveragePercent ?? null;
const artistDirectory =
  (artistsIndexRaw as { artists: Array<{ slug: string; name: string; songCount: number }> })
    .artists ?? [];
const artistCount = artistDirectory.length;
const baseUrl = normalizeBase(import.meta.env.BASE_URL);

const archiveStats = [
  { label: 'COLLECTIONS', value: mainCollectionCount, ariaLabel: 'Main collections' },
  { label: 'ARTISTS', value: artistCount, ariaLabel: 'Featured artists' },
  {
    label: 'SONGS',
    value: formatStatRange(totalSongsIndexed),
    ariaLabel: 'Total indexed songs',
    title: `${totalSongsIndexed.toLocaleString()} files indexed from the remote archive`,
  },
  { label: 'ARCHIVES', value: monthlyArchiveCount, ariaLabel: 'Monthly archives' },
];
---

<ArchivePageShell
  title="RBS Song Archive"
  description="Browse and explore ReBirth RB-338 song collections, artists, and individual .rbs files."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Songs', href: '/archive/songs/' },
  ]}
  pageHeading="RBS Song Archive"
  headingClass="rb-heading-green"
  headerTitle="RBS SONG ARCHIVE BROWSER"
  headerLedLabel={`${formatStatRange(totalSongsIndexed)} INDEXED`}
  headerSubtitle="Browse song folders and search every catalogued .rbs song file in plain language."
  stats={archiveStats}
  showViewToggle={true}
>
  <Fragment slot="search">
    <div class="sticky-search">
      <p class="search-explainer">
        New here? Start with <a href={`${baseUrl}/beginner-guide`}>Beginner Guide</a> or open the <a
          href={`${baseUrl}/glossary`}>Glossary</a
        > for <abbr title="ReBirth Song file">.rbs</abbr> terms.
      </p>
      <ArchivePinControl />
      <div class="search-bar">
        <input
          type="text"
          id="searchInput"
          placeholder="Search song groups and artist names... (Press / to focus)"
          class="rb-search-input"
          aria-label="Search song collections"
        />
        <ActionButton variant="mix" onclick="clearAllFilters()">Clear All</ActionButton>
      </div>
      <div class="filter-bar" role="group" aria-label="Quick filters">
        <button class="rb-filter-btn active" data-filter="all" type="button" aria-pressed="true"
          >All Song Groups</button
        >
        <button class="rb-filter-btn" data-filter="featured" type="button" aria-pressed="false"
          >Recommended</button
        >
        <button class="rb-filter-btn" data-filter="bySource" type="button" aria-pressed="false"
          >By Archive Source</button
        >
        <button class="rb-filter-btn" data-filter="artists" type="button" aria-pressed="false"
          >Songs by Artist</button
        >
        <button class="rb-filter-btn" data-filter="monthly" type="button" aria-pressed="false"
          >Monthly Packs</button
        >
        <button class="rb-filter-btn" data-filter="other" type="button" aria-pressed="false"
          >Other Collections</button
        >
      </div>
      <div class="results-bar" aria-live="polite" aria-atomic="true">
        <span id="resultCount" class="result-count">Showing all song collections</span>
      </div>
    </div>
  </Fragment>

  <Fragment slot="curated">
    <!-- Grid view -->
    <div id="gridView" class="collections-grid" role="main">
      <div data-section-key="featured" class="collection-wrapper">
        {
          songCollections.featured && (
            <CollectionCard
              section={songCollections.featured}
              meta={collectionsMeta.featured}
              archiveUrl={archiveBaseUrl}
              rackmount={true}
            />
          )
        }
      </div>
      <div data-section-key="bySource" class="collection-wrapper">
        {
          songCollections.bySource && (
            <CollectionCard
              section={songCollections.bySource}
              meta={collectionsMeta.bySource}
              archiveUrl={archiveBaseUrl}
              rackmount={true}
            />
          )
        }
      </div>
      <div data-section-key="artists" class="collection-wrapper">
        {
          songCollections.artists && (
            <CollectionCard
              section={songCollections.artists}
              meta={collectionsMeta.artists}
              archiveUrl={archiveBaseUrl}
              rackmount={true}
            />
          )
        }
      </div>
      <div data-section-key="monthly" class="collection-wrapper">
        {
          songCollections.monthly && (
            <CollectionCard
              section={songCollections.monthly}
              meta={collectionsMeta.monthly}
              archiveUrl={archiveBaseUrl}
              rackmount={true}
            />
          )
        }
      </div>
      <div data-section-key="other" class="collection-wrapper">
        {
          songCollections.other && (
            <CollectionCard
              section={songCollections.other}
              meta={collectionsMeta.other}
              archiveUrl={archiveBaseUrl}
              rackmount={true}
            />
          )
        }
      </div>
      <ArchiveEmptyState
        id="gridEmptyState"
        message="No song groups match your search. Try another keyword, or open Recommended for quick picks."
      />
    </div>

    <!-- List view -->
    <div id="listView" class="is-hidden" role="main">
      <HardwarePanel variant="rackmount" class="list-table-wrapper" title="ALL COLLECTIONS">
        <div class="table-scroll">
          <table class="archive-table" id="listTable">
            <thead>
              <tr>
                <th scope="col">
                  <button
                    class="sort-btn"
                    data-sort="name"
                    type="button"
                    aria-label="Sort by collection name"
                  >
                    Song Group <span class="sort-indicator" aria-hidden="true">↕</span>
                  </button>
                </th>
                <th scope="col">Category</th>
                <th scope="col" class="col-numeric">
                  <button
                    class="sort-btn"
                    data-sort="count"
                    type="button"
                    aria-label="Sort by file count"
                  >
                    Song Files <span class="sort-indicator" aria-hidden="true">↕</span>
                  </button>
                </th>
                <th scope="col">Tags</th>
                <th scope="col">Curator</th>
                <th scope="col">Updated</th>
                <th scope="col" class="col-action">Action</th>
              </tr>
            </thead>
            <tbody id="listTableBody"></tbody>
          </table>
        </div>
        <ArchiveEmptyState
          id="listEmptyState"
          message="No song groups match your search. Try another keyword, or switch to Recommended."
        />
      </HardwarePanel>
    </div>
  </Fragment>

  <Fragment slot="raw-label">Search &amp; Artist Directory</Fragment>

  <Fragment slot="raw-index">
    {
      artistDirectory.length > 0 && (
        <HardwarePanel variant="rackmount" title="ARTIST DIRECTORY" class="artist-directory-panel">
          <p class="raw-subtitle">
            Artist pages merge duplicate folder names (example: Noah Cohn Complete + Extended) into
            one profile.
          </p>
          <ul class="artist-directory" role="list">
            {artistDirectory.map((artist) => (
              <li>
                <a
                  href={`${baseUrl}/archive/artists/${artist.slug}/`}
                  class="artist-directory__link"
                >
                  <span class="artist-directory__name">{artist.name}</span>
                  <span class="artist-directory__count">{artist.songCount} songs</span>
                </a>
              </li>
            ))}
          </ul>
        </HardwarePanel>
      )
    }

    <HardwarePanel
      variant="rackmount"
      animate
      title="SEARCH ALL .RBS FILES"
      ledStatus="online"
      ledLabel={`${totalRaw.toLocaleString()} INDEXED`}
      class="song-search-panel"
    >
      <p class="raw-subtitle">
        {
          coveragePercent !== null ? (
            <>
              Search <strong>{totalRaw.toLocaleString()}</strong> catalogued files (
              {coveragePercent}% of manifest estimate). Results load instantly via MiniSearch — no
              5,000-row DOM dump.
            </>
          ) : (
            <>
              Search <strong>{totalRaw.toLocaleString()}</strong> catalogued .rbs files with
              collection, source, and MOD facets.
            </>
          )
        }
      </p>

      <div id="songSearchRoot" class="song-search-root">
        <div class="raw-search-row">
          <input
            type="text"
            id="songSearch"
            placeholder={`Search titles, artists, filenames across ${totalRaw.toLocaleString()} files...`}
            class="rb-search-input"
            aria-label="Search complete song index"
            autocomplete="off"
          />
          <span id="songCount" class="raw-count">Loading index…</span>
        </div>

        <div class="facet-bar" role="group" aria-label="Song index facets">
          <label class="facet-field">
            <span class="facet-label">Collection</span>
            <select id="facetCollection" class="facet-select" aria-label="Filter by collection">
              <option value="">All collections</option>
            </select>
          </label>
          <label class="facet-field">
            <span class="facet-label">Source</span>
            <select
              id="facetSource"
              class="facet-select"
              aria-label="Filter by ReBirth source version"
            >
              <option value="">All sources</option>
            </select>
          </label>
          <label class="facet-field facet-field--bpm">
            <span class="facet-label">BPM</span>
            <span class="bpm-range">
              <input
                type="number"
                id="facetBpmMin"
                class="facet-input"
                min="60"
                max="220"
                placeholder="Min"
                aria-label="Minimum BPM"
              />
              <span aria-hidden="true">–</span>
              <input
                type="number"
                id="facetBpmMax"
                class="facet-input"
                min="60"
                max="220"
                placeholder="Max"
                aria-label="Maximum BPM"
              />
            </span>
          </label>
          <label class="facet-check">
            <input type="checkbox" id="facetModOnly" />
            <span id="facetModLabel">MOD-dependent</span>
          </label>
          <button type="button" id="clearSongFilters" class="rb-mix-btn facet-clear">Clear</button>
        </div>

        <p id="songSearchHint" class="search-hint">
          Type to search, or pick a facet. For your first session, try “Songs by Artist” and browse
          one creator at a time.
        </p>

        <div id="songResults" class="song-results" aria-live="polite"></div>
        <ArchiveEmptyState
          id="songEmpty"
          message="No songs match your search or filters. Clear filters or try a broader artist or collection term."
        />
      </div>
    </HardwarePanel>
  </Fragment>
</ArchivePageShell>

<style>
  /* Search bar */
  .search-explainer {
    margin: 0;
    font-size: 0.78rem;
    color: var(--rb-silver-dim);
  }

  .search-explainer a {
    color: var(--rb-amber);
    text-decoration: none;
  }

  .search-explainer a:hover,
  .search-explainer a:focus-visible {
    color: var(--rb-green-bright);
    text-decoration: underline;
  }

  .search-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .search-bar :global(.rb-mix-btn) {
    align-self: flex-start;
  }

  /* Filter buttons styled via rebirth-theme.css .rb-filter-btn */
  .filter-bar {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* Results bar */
  .results-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    color: var(--rb-silver-dim, #888);
    letter-spacing: 0.05em;
  }

  .result-count {
    text-transform: uppercase;
  }

  /* Collections grid */
  .collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 480px) {
    .collections-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  /* List table */
  .archive-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.82rem;
  }

  .archive-table th {
    text-align: left;
    padding: 0.6em 1em;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    border-bottom: 1px solid #2a2a2a;
    background: #1e1e1e;
    white-space: nowrap;
  }

  .archive-table td {
    padding: 0.55em 1em;
    border-bottom: 1px solid #1e1e1e;
    color: #888;
    vertical-align: middle;
  }

  .archive-table tr:hover td {
    background: rgba(255, 176, 0, 0.04);
    color: #c0c0c0;
  }

  .sort-btn {
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sort-btn:hover {
    color: var(--rb-amber);
  }

  .sort-btn[data-dir='asc'] .sort-indicator,
  .sort-btn[data-dir='desc'] .sort-indicator {
    color: var(--rb-amber);
  }

  .col-numeric,
  .cell-count,
  .col-action,
  .cell-action {
    text-align: right;
  }

  .archive-table .open-link {
    color: #ffb000;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .archive-table .open-link:hover {
    color: #3dba66;
  }

  .archive-table .open-link:focus-visible {
    outline: none;
    color: #3dba66;
    text-decoration: underline;
    box-shadow: 0 0 0 2px rgba(57, 255, 20, 0.15);
    border-radius: 2px;
  }

  /* List view cell helpers */
  .archive-table .cell-name {
    font-weight: bold;
    color: #c0c0c0;
  }

  .archive-table .cell-section {
    color: #555;
  }

  .archive-table .cell-section-name {
    color: #aaa;
  }

  .archive-table .cell-section-desc {
    font-size: 0.75rem;
    color: #666;
    margin-top: 2px;
  }

  .archive-table .cell-count {
    color: var(--rb-green-bright);
    white-space: nowrap;
  }

  .archive-table .cell-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .list-tag {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 5px;
    border-radius: 2px;
    background: rgba(255, 176, 0, 0.08);
    color: var(--rb-amber-dim, #b37800);
    border: 1px solid rgba(255, 176, 0, 0.15);
    white-space: nowrap;
  }

  .archive-table .cell-curator,
  .archive-table .cell-updated {
    font-size: 0.75rem;
    color: #666;
    white-space: nowrap;
  }

  .archive-table .cell-action {
    white-space: nowrap;
  }

  /* Responsive table wrapper */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-scroll .archive-table {
    min-width: 720px;
  }

  /* ── Complete Song Index (mirrors mods raw-index pattern) ── */
  .raw-subtitle {
    font-size: 0.9rem;
    color: #aaa;
    margin: 0 0 1.25rem;
  }

  .artist-directory-panel {
    margin-bottom: 1.25rem;
  }

  .artist-directory {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .artist-directory__link {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid #333;
    border-radius: 4px;
    text-decoration: none;
    color: #aaa;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.82rem;
    transition:
      border-color 120ms ease,
      color 120ms ease,
      background 120ms ease;
  }

  .artist-directory__link:hover {
    color: var(--rb-amber);
    border-color: rgba(255, 176, 0, 0.35);
    background: rgba(255, 176, 0, 0.05);
  }

  .artist-directory__count {
    color: var(--rb-green-bright);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .song-search-root.is-loading {
    opacity: 0.72;
  }

  .facet-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: flex-end;
    margin-bottom: 1rem;
  }

  .facet-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 140px;
  }

  .facet-label {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666;
  }

  .facet-select,
  .facet-input {
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 3px;
    color: #c0c0c0;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.78rem;
    padding: 0.35rem 0.5rem;
  }

  .bpm-range {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .facet-input {
    width: 4.5rem;
  }

  .facet-check {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    color: #888;
    min-height: 2rem;
  }

  .facet-clear {
    align-self: flex-end;
  }

  .search-hint {
    font-size: 0.78rem;
    color: #666;
    margin: 0 0 0.85rem;
  }

  .song-results {
    display: grid;
    gap: 0.35rem;
  }

  :global(.song-result) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 0.75rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.15);
  }

  :global(.song-result__title) {
    margin: 0;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.82rem;
    color: #c0c0c0;
  }

  :global(.song-result__meta) {
    margin: 0.15rem 0 0;
    font-size: 0.68rem;
    color: #666;
  }

  :global(.result-artist) {
    color: var(--rb-amber-dim);
    text-decoration: none;
  }

  :global(.result-artist:hover) {
    color: var(--rb-amber);
    text-decoration: underline;
  }

  :global(.result-bpm),
  :global(.result-mod) {
    display: inline-block;
    margin-left: 0.35rem;
    font-size: 0.56rem;
    padding: 1px 4px;
    border-radius: 2px;
    letter-spacing: 0.03em;
  }

  :global(.result-bpm) {
    background: rgba(57, 255, 20, 0.08);
    color: var(--rb-green-bright);
    border: 1px solid var(--rb-green-dim);
  }

  :global(.result-mod) {
    background: rgba(255, 176, 0, 0.1);
    color: var(--rb-amber);
    border: 1px solid rgba(255, 176, 0, 0.25);
  }

  :global(.song-result__actions) {
    display: flex;
    gap: 0.35rem;
    align-items: flex-start;
  }

  :global(.song-result__play),
  :global(.song-result__download) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 3px;
    border: 1px solid var(--rb-border);
    background: linear-gradient(180deg, #363636 0%, #282828 100%);
    color: var(--rb-silver-dim);
    text-decoration: none;
    cursor: pointer;
  }

  :global(.song-result__play) {
    color: var(--rb-green-bright);
    border-color: var(--rb-green-dim);
  }

  :global(.song-result__play:hover),
  :global(.song-result__download:hover) {
    color: var(--rb-amber);
    border-color: var(--rb-amber-dim);
  }

  .raw-search-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .raw-search-row .rb-search-input {
    flex: 1;
    min-width: 200px;
  }

  .raw-count {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    color: var(--rb-silver-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .az-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .az-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 28px;
    padding: 0.2em 0.5em;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--rb-silver-dim);
    background: linear-gradient(180deg, #2a2a2a 0%, #222 100%);
    border: 1px solid var(--rb-border);
    border-radius: 3px;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .az-nav__link:hover {
    color: var(--rb-amber);
    border-color: var(--rb-amber-dim);
    box-shadow: 0 0 8px rgba(255, 176, 0, 0.1);
  }

  .raw-index {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .raw-group__heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .raw-group__letter {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 1.2rem;
