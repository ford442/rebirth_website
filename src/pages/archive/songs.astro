---
// Song Archive Browser — /archive/songs
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CollectionCard from '../../components/CollectionCard.astro';
import HardwarePanel from '../../components/ui/HardwarePanel.astro';
import Led from '../../components/ui/Led.astro';
import Lcd from '../../components/ui/Lcd.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
import collectionsMeta from '../../data/collections-metadata.json';
import { songCollections, archiveBaseUrl } from '../../data/song-collections';
import fullIndexRaw from '../../data/songs-full-index.json';
import { formatStatRange, totalSongsIndexed, mainCollectionCount, artistCount, monthlyArchiveCount } from '../../data/archive-stats';

interface SongEntry {
  filename: string;
  url: string;
  title: string;
  collection: string;
  subcollection: string | null;
  artist: string | null;
  bpm: number | null;
  fileSize: string;
  source: string;
}

interface FullIndex {
  songs: SongEntry[];
  meta: {
    totalFiles: number;
    coveragePercent: number | null;
    source: string;
  };
}

const fullIndex = fullIndexRaw as unknown as FullIndex;
const allSongs = fullIndex.songs || [];
const totalRaw = allSongs.length;
const coveragePercent = fullIndex.meta?.coveragePercent ?? null;

// A–Z grouping for the complete song index
const letters = new Set<string>();
allSongs.forEach((s) => {
  const c = s.filename?.charAt(0)?.toUpperCase();
  if (c) letters.add(c);
});
const alphaLetters = Array.from(letters).sort();

const grouped = alphaLetters.map((letter) => ({
  letter,
  songs: allSongs.filter((s) => s.filename?.charAt(0)?.toUpperCase() === letter),
}));
---

<BaseLayout title="RBS Song Archive" description="Browse and explore ReBirth RB-338 song collections, artists, and individual .rbs files.">

  <div class="archive-page">
    <div class="container">

      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Songs', href: '/archive/songs/' },
      ]} />

      <div class="rb-heading rb-heading-blue">RBS Song Archive</div>

      <!-- Page header module -->
      <HardwarePanel
        animate
        variant="rackmount-chassis"
        class="archive-header"
        title="RBS SONG ARCHIVE BROWSER"
        ledStatus="online"
        ledLabel={`${formatStatRange(totalSongsIndexed)} INDEXED`}
      >
        <p class="archive-subtitle">Browse collections and search every catalogued .rbs file in the archive</p>
        <div class="sticky-search">
          <div class="search-bar">
            <input
              type="text"
              id="searchInput"
              placeholder="Search collections and artists... (Press / to focus)"
              class="rb-search-input"
              aria-label="Search collections"
            />
            <ActionButton variant="mix" onclick="clearAllFilters()">Clear All</ActionButton>
          </div>
          <div class="filter-bar" role="group" aria-label="Quick filters">
            <button class="rb-filter-btn active" data-filter="all" type="button" aria-pressed="true">All</button>
            <button class="rb-filter-btn" data-filter="featured" type="button" aria-pressed="false">Featured</button>
            <button class="rb-filter-btn" data-filter="bySource" type="button" aria-pressed="false">By Source</button>
            <button class="rb-filter-btn" data-filter="artists" type="button" aria-pressed="false">Artists</button>
            <button class="rb-filter-btn" data-filter="monthly" type="button" aria-pressed="false">Monthly</button>
            <button class="rb-filter-btn" data-filter="other" type="button" aria-pressed="false">Other</button>
          </div>
          <div class="results-bar" aria-live="polite" aria-atomic="true">
            <Led status="online" label="" ariaHidden={true} />
            <span id="resultCount" class="result-count">Showing all collections</span>
          </div>
        </div>
      </HardwarePanel>

      <!-- LCD stats bar -->
      <div class="archive-stats" title={`${totalSongsIndexed.toLocaleString()} files indexed from the remote archive`}>
        <Lcd label="COLLECTIONS" value={mainCollectionCount} ariaLabel="Main collections" />
        <Lcd label="ARTISTS" value={artistCount} ariaLabel="Featured artists" />
        <Lcd label="SONGS" value={formatStatRange(totalSongsIndexed)} ariaLabel="Total indexed songs" />
        <Lcd label="ARCHIVES" value={monthlyArchiveCount} ariaLabel="Monthly archives" />
      </div>

      <!-- View toggle -->
      <div class="view-toggle" role="group" aria-label="View mode">
        <button class="rb-pattern-btn view-btn active" id="btnGrid" onclick="switchView('grid')" type="button" aria-pressed="true" aria-controls="gridView listView">Grid View</button>
        <button class="rb-mix-btn view-btn" id="btnList" onclick="switchView('list')" type="button" aria-pressed="false" aria-controls="gridView listView">List View</button>
      </div>

      <!-- Grid view -->
      <div id="gridView" class="collections-grid" role="main">
        <div data-section-key="featured" class="collection-wrapper">
          {songCollections.featured && (
            <CollectionCard section={songCollections.featured} meta={collectionsMeta.featured} archiveUrl={archiveBaseUrl} rackmount={true} />
          )}
        </div>
        <div data-section-key="bySource" class="collection-wrapper">
          {songCollections.bySource && (
            <CollectionCard section={songCollections.bySource} meta={collectionsMeta.bySource} archiveUrl={archiveBaseUrl} rackmount={true} />
          )}
        </div>
        <div data-section-key="artists" class="collection-wrapper">
          {songCollections.artists && (
            <CollectionCard section={songCollections.artists} meta={collectionsMeta.artists} archiveUrl={archiveBaseUrl} rackmount={true} />
          )}
        </div>
        <div data-section-key="monthly" class="collection-wrapper">
          {songCollections.monthly && (
            <CollectionCard section={songCollections.monthly} meta={collectionsMeta.monthly} archiveUrl={archiveBaseUrl} rackmount={true} />
          )}
        </div>
        <div data-section-key="other" class="collection-wrapper">
          {songCollections.other && (
            <CollectionCard section={songCollections.other} meta={collectionsMeta.other} archiveUrl={archiveBaseUrl} rackmount={true} />
          )}
        </div>
        <div id="gridEmptyState" class="rb-empty-state is-hidden" aria-live="polite">
          <p>No collections match your search. Try different keywords or clear the filter.</p>
        </div>
      </div>

      <!-- List view -->
      <div id="listView" class="is-hidden" role="main">
        <HardwarePanel variant="rackmount" class="list-table-wrapper" title="ALL COLLECTIONS">
          <div class="table-scroll">
            <table class="archive-table" id="listTable">
              <thead>
                <tr>
                  <th scope="col">
                    <button class="sort-btn" data-sort="name" type="button" aria-label="Sort by collection name">
                      Collection <span class="sort-indicator" aria-hidden="true">↕</span>
                    </button>
                  </th>
                  <th scope="col">Section</th>
                  <th scope="col" class="col-numeric">
                    <button class="sort-btn" data-sort="count" type="button" aria-label="Sort by file count">
                      Files <span class="sort-indicator" aria-hidden="true">↕</span>
                    </button>
                  </th>
                  <th scope="col">Tags</th>
                  <th scope="col">Curator</th>
                  <th scope="col">Updated</th>
                  <th scope="col" class="col-action">Action</th>
                </tr>
              </thead>
              <tbody id="listTableBody"></tbody>
            </table>
          </div>
          <div id="listEmptyState" class="rb-empty-state is-hidden">
            <p>No collections match your search. Try different keywords or clear the filter.</p>
          </div>
        </HardwarePanel>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════ -->
      <!--  COMPLETE SONG INDEX (all catalogued .rbs files)                -->
      <!-- ═══════════════════════════════════════════════════════════════ -->
      <div class="section-divider">
        <span class="section-divider__label">Complete Song Index</span>
      </div>

      <HardwarePanel
        variant="rackmount"
        animate
        title="ALL AVAILABLE .RBS FILES"
        ledStatus="online"
        ledLabel={`${totalRaw.toLocaleString()} FILES`}
      >
        <p class="raw-subtitle">
          {coveragePercent !== null ? (
            <>
              <strong>{totalRaw.toLocaleString()}</strong> catalogued .rbs files indexed
              ({coveragePercent}% of the manifest estimate). Each entry links to a direct download.
            </>
          ) : (
            <>
              <strong>{totalRaw.toLocaleString()}</strong> catalogued .rbs files indexed.
              Each entry links to a direct download.
            </>
          )}
        </p>

        <!-- Filename search -->
        <div class="raw-search-row">
          <input
            type="text"
            id="songSearch"
            placeholder={`Filter all ${totalRaw.toLocaleString()} filenames...`}
            class="rb-search-input"
            aria-label="Filter complete song index"
          />
          <span id="songCount" class="raw-count">{totalRaw.toLocaleString()} files</span>
        </div>

        <!-- A-Z jump nav -->
        <nav class="az-nav" aria-label="Jump to letter">
          {alphaLetters.map((letter) => (
            <a href={`#letter-${letter}`} class="az-nav__link">{letter}</a>
          ))}
        </nav>

        <!-- Grouped list -->
        <div id="songIndex" class="raw-index">
          {grouped.map(({ letter, songs }) => (
            <section class="raw-group" id={`letter-${letter}`} data-letter={letter}>
              <h2 class="raw-group__heading">
                <span class="raw-group__letter">{letter}</span>
                <Led status="online" label={`${songs.length} FILE${songs.length !== 1 ? 'S' : ''}`} ariaHidden={true} />
              </h2>
              <div class="raw-list">
                {songs.map((song) => (
                  <div class="raw-item" data-filename={song.filename.toLowerCase()} data-collection={song.collection.toLowerCase()} data-artist={(song.artist ?? '').toLowerCase()}>
                    <div class="raw-item__main">
                      <span class="raw-item__name" title={song.filename}>
                        {song.filename.replace(/\.rbs$/i, '')}
                      </span>
                      <span class="raw-item__size">{song.fileSize}</span>
                    </div>
                    <div class="raw-item__meta">
                      <span class="raw-item__collection">{song.collection}</span>
                      {song.subcollection && song.subcollection !== song.collection && (
                        <span class="raw-item__subcollection">{song.subcollection}</span>
                      )}
                      {song.artist && (
                        <span class="raw-item__author">by {song.artist}</span>
                      )}
                      {song.bpm && (
                        <span class="raw-item__bpm">{song.bpm} BPM</span>
                      )}
                    </div>
                    <a
                      href={song.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="raw-item__link"
                      aria-label={`Download ${song.filename} from test.1ink.us, opens in new tab`}
                      title={`Download ${song.filename} from test.1ink.us (opens in new tab)`}
                    >
                      <span aria-hidden="true">↓</span>
                    </a>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </div>

        <div id="songEmpty" class="rb-empty-state is-hidden">
          <p>No songs match your filter.</p>
        </div>
      </HardwarePanel>

    </div>
  </div>

</BaseLayout>

<style>
  .archive-page {
    padding-block: 2rem 4rem;
    background: #0f0f0f;
    min-height: 60vh;
  }

  /* Header module */
  .archive-header { margin-bottom: 1rem; }

  .archive-header :global(.rb-panel__body) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .archive-subtitle {
    font-size: 0.875rem;
    color: #888;
    margin: 0;
  }

  /* Search bar */
  .search-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .search-bar :global(.rb-mix-btn) {
    align-self: flex-start;
  }

  /* Filter buttons styled via rebirth-theme.css .rb-filter-btn */
  .filter-bar {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* Results bar */
  .results-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    color: var(--rb-silver-dim, #888);
    letter-spacing: 0.05em;
  }

  .result-count {
    text-transform: uppercase;
  }

  /* Stats row */
  .archive-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  /* View toggle */
  .view-toggle {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .view-btn {
    opacity: 0.6;
    transition: opacity 120ms ease;
  }

  .view-btn.active { opacity: 1; }

  .view-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px rgba(255,176,0,0.25);
  }

  /* Collections grid */
  .collections-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 480px) {
    .collections-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
  }

  /* List table */
  .archive-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.82rem;
  }

  .archive-table th {
    text-align: left;
    padding: 0.6em 1em;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    border-bottom: 1px solid #2a2a2a;
    background: #1e1e1e;
    white-space: nowrap;
  }

  .archive-table td {
    padding: 0.55em 1em;
    border-bottom: 1px solid #1e1e1e;
    color: #888;
    vertical-align: middle;
  }

  .archive-table tr:hover td {
    background: rgba(255,176,0,0.04);
    color: #c0c0c0;
  }

  .sort-btn {
    background: transparent;
    border: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .sort-btn:hover {
    color: var(--rb-amber);
  }

  .sort-btn[data-dir='asc'] .sort-indicator,
  .sort-btn[data-dir='desc'] .sort-indicator {
    color: var(--rb-amber);
  }

  .col-numeric,
  .cell-count,
  .col-action,
  .cell-action {
    text-align: right;
  }

  .archive-table .open-link {
    color: #ffb000;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .archive-table .open-link:hover {
    color: #3dba66;
  }

  .archive-table .open-link:focus-visible {
    outline: none;
    color: #3dba66;
    text-decoration: underline;
    box-shadow: 0 0 0 2px rgba(57,255,20,0.15);
    border-radius: 2px;
  }

  /* List view cell helpers */
  .archive-table .cell-name {
    font-weight: bold;
    color: #c0c0c0;
  }

  .archive-table .cell-section {
    color: #555;
  }

  .archive-table .cell-section-name {
    color: #aaa;
  }

  .archive-table .cell-section-desc {
    font-size: 0.75rem;
    color: #666;
    margin-top: 2px;
  }

  .archive-table .cell-count {
    color: var(--rb-green-bright);
    white-space: nowrap;
  }

  .archive-table .cell-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .list-tag {
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 5px;
    border-radius: 2px;
    background: rgba(255, 176, 0, 0.08);
    color: var(--rb-amber-dim, #b37800);
    border: 1px solid rgba(255, 176, 0, 0.15);
    white-space: nowrap;
  }

  .archive-table .cell-curator,
  .archive-table .cell-updated {
    font-size: 0.75rem;
    color: #666;
    white-space: nowrap;
  }

  .archive-table .cell-action {
    white-space: nowrap;
  }

  /* Responsive table wrapper */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-scroll .archive-table {
    min-width: 720px;
  }

  /* ── Complete Song Index (mirrors mods raw-index pattern) ── */
  .section-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2.5rem 0 1.5rem;
  }

  .section-divider::before,
  .section-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, #333, transparent);
  }

  .section-divider__label {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--rb-silver-dim);
    white-space: nowrap;
  }

  .raw-subtitle {
    font-size: 0.9rem;
    color: #aaa;
    margin: 0 0 1.25rem;
  }

  .raw-search-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .raw-search-row .rb-search-input {
    flex: 1;
    min-width: 200px;
  }

  .raw-count {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    color: var(--rb-silver-dim);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .az-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .az-nav__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 28px;
    padding: 0.2em 0.5em;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--rb-silver-dim);
    background: linear-gradient(180deg, #2a2a2a 0%, #222 100%);
    border: 1px solid var(--rb-border);
    border-radius: 3px;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .az-nav__link:hover {
    color: var(--rb-amber);
    border-color: var(--rb-amber-dim);
    box-shadow: 0 0 8px rgba(255,176,0,0.1);
  }

  .raw-index {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .raw-group__heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .raw-group__letter {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--rb-amber);
    text-shadow: 0 0 10px rgba(255,176,0,0.25);
    min-width: 24px;
  }

  .raw-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
  }

  @media (min-width: 640px) {
    .raw-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .raw-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .raw-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    background: rgba(0,0,0,0.15);
    border: 1px solid transparent;
    border-radius: 4px;
    transition: background 120ms ease, border-color 120ms ease;
    position: relative;
    flex-wrap: wrap;
  }

  .raw-item:hover {
    background: rgba(255,176,0,0.04);
    border-color: rgba(255,176,0,0.15);
  }

  .raw-item__main {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  .raw-item__name {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.8rem;
    color: #aaa;
    letter-spacing: 0.02em;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .raw-item__size {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.65rem;
    color: #555;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .raw-item__meta {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.25rem;
    margin-top: 0.25rem;
    border-top: 1px solid rgba(255,255,255,0.03);
  }

  .raw-item__collection {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.7rem;
    color: var(--rb-amber-dim);
  }

  .raw-item__subcollection {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.7rem;
    color: #666;
  }

  .raw-item__subcollection::before {
    content: '/';
    margin-right: 0.25rem;
    color: #444;
  }

  .raw-item__author {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.7rem;
    color: #666;
  }

  .raw-item__bpm {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.6rem;
    padding: 1px 4px;
    border-radius: 2px;
    background: rgba(57,255,20,0.08);
    color: var(--rb-green-bright);
    border: 1px solid var(--rb-green-dim);
    white-space: nowrap;
  }

  .raw-item__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.9rem;
    color: var(--rb-silver-dim);
    background: linear-gradient(180deg, #363636 0%, #282828 100%);
    border: 1px solid var(--rb-border);
    border-bottom: 2px solid #111;
    border-radius: 3px;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .raw-item__link:hover {
    color: var(--rb-amber);
    border-color: var(--rb-amber-dim);
    box-shadow: 0 0 8px rgba(255,176,0,0.15);
  }

  .sticky-search {
    position: sticky;
    top: 3.75rem;
    z-index: 50;
    background: rgba(15, 15, 15, 0.96);
    backdrop-filter: blur(8px);
    margin: 0 -1.25rem;
    padding: 0.5rem 1.25rem;
    border-block: 1px solid rgba(255, 255, 255, 0.05);
  }

  .filter-bar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .filter-bar::-webkit-scrollbar {
    display: none;
  }

  .az-nav {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .az-nav::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-search {
      top: 3.5rem;
      margin: 0 -1rem;
      padding: 0.5rem 1rem;
    }

    .filter-bar {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0.5rem;
      padding-bottom: 0.35rem;
      mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent 100%);
    }

    .filter-bar .rb-filter-btn {
      flex-shrink: 0;
      scroll-snap-align: start;
      min-height: 44px;
