</style>

<script>
  import '../../scripts/archive-browser';
</script>

<script>
  /* ── Complete song index filter ───────────────────────────────── */
  const songSearch = document.getElementById('songSearch');
  const songItems = document.querySelectorAll('.raw-item');
  const songGroups = document.querySelectorAll('.raw-group');
  const songEmpty = document.getElementById('songEmpty');
  const songCount = document.getElementById('songCount');

  function filterSongs() {
    const term = (songSearch as HTMLInputElement | null)?.value.toLowerCase() ?? '';
    let visibleFiles = 0;
    let visibleGroups = 0;

    songGroups.forEach((group) => {
      let groupVisible = 0;
      const items = group.querySelectorAll('.raw-item');
      items.forEach((item) => {
        const filename = item.getAttribute('data-filename') ?? '';
        const collection = item.getAttribute('data-collection') ?? '';
        const artist = item.getAttribute('data-artist') ?? '';
        const isVisible = !term || filename.includes(term) || collection.includes(term) || artist.includes(term);
        (item as HTMLElement).style.display = isVisible ? '' : 'none';
        if (isVisible) {
          groupVisible++;
          visibleFiles++;
        }
      });
      (group as HTMLElement).style.display = groupVisible > 0 ? '' : 'none';
      if (groupVisible > 0) visibleGroups++;
    });

    if (songCount) {
      songCount.textContent = term
        ? `${visibleFiles} of ${songItems.length} files`
        : `${songItems.length} files`;
    }
    if (songEmpty) {
      songEmpty.classList.toggle('is-hidden', visibleFiles > 0);
    }
  }

  if (songSearch) {
    songSearch.addEventListener('input', filterSongs);
  }
</script>
