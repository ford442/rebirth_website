---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HardwarePanel from '../../components/ui/HardwarePanel.astro';
import { normalizeBase } from '../../lib/url';

const base = normalizeBase(import.meta.env.BASE_URL);
const docs = await getCollection('docs');

function docPath(entry: (typeof docs)[number]) {
  return entry.id.replace(/\.md$/i, '');
}

function compareVersions(a: string, b: string) {
  const aParts = a.split('.').map((part) => Number.parseInt(part, 10) || 0);
  const bParts = b.split('.').map((part) => Number.parseInt(part, 10) || 0);
  const length = Math.max(aParts.length, bParts.length);

  for (let index = 0; index < length; index += 1) {
    const delta = (bParts[index] ?? 0) - (aParts[index] ?? 0);
    if (delta !== 0) return delta;
  }

  return 0;
}

const sortedDocs = [...docs].sort((left, right) => {
  const versionDelta = compareVersions(left.data.version, right.data.version);
  if (versionDelta !== 0) return versionDelta;

  const leftDate = left.data.releaseDate ?? '';
  const rightDate = right.data.releaseDate ?? '';
  return rightDate.localeCompare(leftDate);
});

const docsByVersion = sortedDocs.reduce((groups, entry) => {
  const key = entry.data.version;
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)?.push(entry);
  return groups;
}, new Map<string, typeof sortedDocs>());
---

<BaseLayout
  title="Docs"
  description="Release notes, preservation plans, and archival reference documents for ReBirth RB-338."
>
  <div class="docs-page">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Docs', href: '/docs' },
        ]}
      />

      <HardwarePanel
        variant="rackmount-chassis"
        animate
        title="DOCUMENTATION HUB"
        ledStatus="online"
        ledLabel={`${sortedDocs.length} DOCS`}
        class="rb-panel--center-header rb-panel--padded-body"
      >
        <p class="docs-subtitle">
          Browse release notes, preservation analysis, and archive-planning references for ReBirth
          RB-338.
        </p>
      </HardwarePanel>

      <div class="docs-groups">
        {
          Array.from(docsByVersion.entries()).map(([version, entries]) => (
            <HardwarePanel
              variant="rackmount-module"
              animate
              title={`VERSION ${version}`}
              ledStatus="online"
              ledLabel={`${entries.length} ${entries.length === 1 ? 'ENTRY' : 'ENTRIES'}`}
            >
              <ul class="docs-list" role="list">
                {entries.map((entry) => (
                  <li class="docs-list__item">
                    <a class="docs-list__link" href={`${base}/docs/${docPath(entry)}`}>
                      <span class="docs-list__title">{entry.data.title}</span>
                      {entry.data.description && (
                        <span class="docs-list__description">{entry.data.description}</span>
                      )}
                      <span class="docs-list__meta">
                        <span>{entry.data.version}</span>
                        {entry.data.releaseDate && <span>{entry.data.releaseDate}</span>}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </HardwarePanel>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .docs-page {
    padding-block: 2rem 4rem;
    min-height: 70vh;
    background: #0f0f0f;
  }

  .docs-subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .docs-groups {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .docs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .docs-list__link {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border: 1px solid var(--rb-border);
    border-radius: 6px;
    background: linear-gradient(180deg, #222222 0%, #1a1a1a 100%);
    text-decoration: none;
  }

  .docs-list__title {
    font-family: var(--rb-font-display);
    font-size: 0.95rem;
    color: var(--rb-amber);
  }

  .docs-list__description {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .docs-list__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--rb-font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rb-silver-dim);
  }
</style>
