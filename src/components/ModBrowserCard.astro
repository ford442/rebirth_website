---
// ModBrowserCard.astro — display a single RBM mod with metadata
import ExternalLink from './ExternalLink.astro';
import { getModSkinUrl, getModSkinUrls } from '../data/rbm-skins';

export interface Props {
  filename: string;
  title: string;
  author?: string;
  /** Release year; null when the archive entry has no established year. */
  year?: number | null;
  description?: string;
  tags?: string[];
  downloadUrl?: string;
  rackmount?: boolean;
}

const {
  filename,
  title,
  author = 'Unknown',
  year,
  description,
  tags = [],
  downloadUrl,
  rackmount = false,
} = Astro.props;

const baseModsUrl = 'https://storage.1ink.us/rebirth_mods';
const modUrl = downloadUrl || `${baseModsUrl}/${filename}`;

const thumbnailUrl = getModSkinUrl(filename);
const skinImages = getModSkinUrls(filename);
---

<div
  class={`mod-card ${rackmount ? 'rb-rack-variant' : ''} ${!description ? 'mod-card--minimal' : ''}`}
>
  {
    thumbnailUrl && (
      <button
        type="button"
        class="mod-card__thumbnail-btn"
        data-skin-lightbox
        data-images={JSON.stringify(skinImages)}
        aria-label={`View panel art for ${title}`}
      >
        <img
          class="mod-card__thumbnail"
          src={thumbnailUrl}
          alt={`${title} panel art`}
          loading="lazy"
          width="128"
          height="128"
        />
      </button>
    )
  }

  <div class="mod-card__header">
    <h3 class="mod-card__title">{title}</h3>
    {year && <span class="mod-card__year">{year}</span>}
  </div>

  <div class="mod-card__author">{author}</div>

  {description && <p class="mod-card__description">{description}</p>}

  {
    tags.length > 0 && (
      <div class="mod-card__tags">
        {tags.map((tag) => (
          <span class="mod-tag">{tag}</span>
        ))}
      </div>
    )
  }

  <div class="mod-card__footer">
    <span class="mod-card__filename">{filename}</span>
    <ExternalLink
      href={modUrl}
      kind="download-rbm"
      class="rb-pattern-btn mod-download-btn"
      ariaLabel={`Download ${title} from storage.1ink.us, opens in new tab`}
    />
  </div>
</div>

<style>
  .mod-card {
    background: linear-gradient(180deg, #2e2e2e 0%, #252525 100%);
    padding: 1rem;
    border-radius: 6px;
    border: 1px solid #3a3a3a;
    border-top: 2px solid #555;
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transition:
      border-color 120ms ease,
      box-shadow 120ms ease;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mod-card:hover {
    border-color: #ffb000;
    box-shadow:
      0 0 16px rgba(0, 0, 0, 0.5),
      0 0 10px rgba(255, 176, 0, 0.15);
  }

  .mod-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .mod-card__title {
    margin: 0;
    font-family: 'Courier New', Courier, monospace;
    font-size: 1rem;
    color: #ffb000;
    flex: 1;
  }

  .mod-card__year {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.75rem;
    color: #888;
    flex-shrink: 0;
  }

  .mod-card__author {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.8rem;
    color: #888;
    letter-spacing: 0.05em;
  }

  .mod-card__description {
    margin: 0;
    font-size: 0.85rem;
    color: #aaa;
    line-height: 1.4;
    flex: 1;
  }

  .mod-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .mod-tag {
    display: inline-block;
    padding: 0.25em 0.6em;
    background: rgba(255, 176, 0, 0.1);
    border: 1px solid rgba(255, 176, 0, 0.3);
    border-radius: 3px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    color: #ffb000;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mod-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #333;
  }

  .mod-card__filename {
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.7rem;
    color: #555;
    word-break: break-all;
    flex: 1;
  }

  .mod-download-btn {
    flex-shrink: 0;
    padding: 0.4em 0.8em;
    font-size: 0.75rem;
  }

  /* Minimal metadata variant (no description) */
  .mod-card--minimal {
    border-left: 2px solid var(--rb-amber, #ffb000);
    opacity: 0.95;
  }

  .mod-card--minimal:hover {
    opacity: 1;
  }

  .mod-card__thumbnail-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    overflow: hidden;
    background: #111;
    cursor: zoom-in;
    line-height: 0;
  }

  .mod-card__thumbnail-btn:hover,
  .mod-card__thumbnail-btn:focus-visible {
    border-color: var(--rb-amber, #ffb000);
  }

  .mod-card__thumbnail {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
</style>

<script>
  // Delegated click handler so N mod cards only cost one listener. Builds a
  // simple lightbox from the `data-images` list on the clicked thumbnail.
  (function () {
    let overlay: HTMLDivElement | null = null;

    function closeLightbox() {
      overlay?.remove();
      overlay = null;
      document.removeEventListener('keydown', onKeydown);
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') closeLightbox();
    }

    function openLightbox(images: string[], alt: string) {
      if (!images.length) return;
      closeLightbox();
      overlay = document.createElement('div');
      overlay.className = 'mod-skin-lightbox';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.innerHTML = `
        <div class="mod-skin-lightbox__frame">
          <button type="button" class="mod-skin-lightbox__close" aria-label="Close">×</button>
          <div class="mod-skin-lightbox__images"></div>
        </div>
      `;
      const imagesEl = overlay.querySelector('.mod-skin-lightbox__images');
      images.forEach((src) => {
        const img = document.createElement('img');
        img.src = src;
        img.alt = alt;
        img.loading = 'lazy';
        imagesEl?.appendChild(img);
      });
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeLightbox();
      });
      overlay.querySelector('.mod-skin-lightbox__close')?.addEventListener('click', closeLightbox);
      document.body.appendChild(overlay);
      document.addEventListener('keydown', onKeydown);
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-skin-lightbox]');
      if (!btn) return;
      e.preventDefault();
      const images = JSON.parse(btn.dataset.images || '[]') as string[];
      const alt = btn.getAttribute('aria-label') || 'Mod panel art';
      openLightbox(images, alt);
    });
  })();
</script>

<style is:global>
  .mod-skin-lightbox {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    padding: 2rem;
  }

  .mod-skin-lightbox__frame {
    position: relative;
    max-width: min(90vw, 720px);
    max-height: 90vh;
    overflow: auto;
    background: #1a1a1a;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 2.5rem 1rem 1rem;
  }

  .mod-skin-lightbox__images {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .mod-skin-lightbox__images img {
    max-width: 100%;
    max-height: 70vh;
    border-radius: 4px;
  }

  .mod-skin-lightbox__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 2rem;
    height: 2rem;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    background: #222;
    color: #ccc;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }

  .mod-skin-lightbox__close:hover {
    border-color: var(--rb-amber, #ffb000);
    color: var(--rb-amber, #ffb000);
  }
</style>
