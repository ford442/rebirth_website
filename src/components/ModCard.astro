---
// ModCard.astro — reusable card for displaying individual mods or songs
import ExternalLink from './ExternalLink.astro';

export interface Props {
  /** Display title of the mod or song */
  title: string;
  /** File type label, e.g. ".rbm" or ".rbs" */
  fileType: '.rbm' | '.rbs' | string;
  /** Short description or notes */
  description?: string;
  /** Author / creator name */
  author?: string;
  /** Download or detail page href */
  href?: string;
  /** Link target, e.g. "_blank" */
  target?: string;
  /** Link rel, e.g. "noopener noreferrer" */
  rel?: string;
  /** Optional tags, e.g. ["acid", "303", "ambient"] */
  tags?: string[];
  /** Apply rackmount hardware styling */
  rackmount?: boolean;
  /** Optional on-site browse URL for song collections */
  browseHref?: string;
  /** Optional collection path display for songs */
  collectionPath?: string;
  /** Optional song/file count display */
  songCount?: number;
  /** Optional BPM display */
  bpm?: number;
  /** Optional compatibility/version note */
  compatibility?: string;
  /** Optional demo preview source for songs */
  demoSrc?: string;
  /** Optional external host label, e.g. test.1ink.us */
  externalHostLabel?: string;
  /** Optional tag target resolver */
  tagHrefBase?: string;
}

const {
  title,
  fileType,
  description,
  author,
  href,
  target,
  rel,
  tags = [],
  rackmount = false,
  browseHref,
  collectionPath,
  songCount,
  bpm,
  compatibility,
  demoSrc,
  externalHostLabel,
  tagHrefBase,
} = Astro.props;

const isSong = fileType === '.rbs';
const isMod = fileType === '.rbm';
const typeClass = isSong ? 'type--song' : isMod ? 'type--mod' : 'type--other';
---

<article
  class={`mod-card rb-file-card ${typeClass} ${rackmount ? 'rb-rack-variant' : ''}`}
  aria-label={`${fileType} — ${title}`}
>
  <header class="mod-card__header">
    <span
      class={`mod-card__badge rb-badge ${isSong ? 'rb-badge--song' : isMod ? 'rb-badge--mod' : ''}`}
      aria-hidden="true">{fileType}</span
    >
    <div class="mod-card__title-block">
      <h3 class="mod-card__title">{title}</h3>
    </div>
  </header>

  {
    (collectionPath || songCount || bpm || compatibility) && (
      <dl class="mod-card__meta" aria-label="Archive metadata">
        {collectionPath && (
          <div class="mod-card__meta-row">
            <dt>Path</dt>
            <dd>{collectionPath}</dd>
          </div>
        )}
        {typeof songCount === 'number' && (
          <div class="mod-card__meta-row">
            <dt>Files</dt>
            <dd>{songCount}</dd>
          </div>
        )}
        {typeof bpm === 'number' && (
          <div class="mod-card__meta-row">
            <dt>BPM</dt>
            <dd>{bpm}</dd>
          </div>
        )}
        {compatibility && (
          <div class="mod-card__meta-row">
            <dt>Version</dt>
            <dd>{compatibility}</dd>
          </div>
        )}
      </dl>
    )
  }

  {description && <p class="mod-card__desc">{description}</p>}

  <footer class="mod-card__footer">
    {
      author && (
        <span class="mod-card__author">
          <span class="sr-only">Author: </span>
          {author}
        </span>
      )
    }

    {
      tags.length > 0 && (
        <ul class="mod-card__tags" aria-label="Tags" role="list">
          {tags.map((tag) => (
            <li>
              <a
                class="mod-card__tag mod-card__tag-link"
                href={tagHrefBase ? `${tagHrefBase}${encodeURIComponent(tag)}` : '#'}
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="mod-card__actions">
      {
        browseHref && (
          <a class="mod-card__action mod-card__action--secondary" href={browseHref}>
            Browse Collection
          </a>
        )
      }

      {
        demoSrc && (
          <button
            class="mod-card__action mod-card__action--preview"
            type="button"
            data-preview-src={demoSrc}
            data-preview-label={title}
            data-preview-bpm={bpm ? String(bpm) : ''}
          >
            Preview
          </button>
        )
      }

      {
        href && (
          <ExternalLink
            href={href}
            kind={isSong ? 'browse-folder' : isMod ? 'download-rbm' : 'external'}
            host={externalHostLabel}
            target={target}
            rel={rel}
            class="mod-card__action mod-card__action--primary"
          />
        )
      }
    </div>
  </footer>
</article>

<script>
  import { dispatchLoadDemo, scrollToPlayer } from '../lib/player-events';

  document.querySelectorAll('.mod-card__action--preview').forEach((button) => {
    if (!(button instanceof HTMLButtonElement)) return;
    button.addEventListener('click', () => {
      const detail = {
        src: button.dataset.previewSrc ?? '',
        label: button.dataset.previewLabel ?? 'archive preview',
        bpm: button.dataset.previewBpm ? Number(button.dataset.previewBpm) : undefined,
      };
      dispatchLoadDemo(detail);
      scrollToPlayer();
    });
  });
</script>

<style>
  .mod-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--rb-radius);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .mod-card:hover {
    border-color: var(--color-amber-dim);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.5),
      0 0 12px -4px var(--color-amber-dim),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .mod-card {
      transition-property: border-color, box-shadow;
    }
    .mod-card:hover {
      transform: none;
    }
  }

  /* Left accent strip by type */
  .mod-card.type--song {
    border-left: 3px solid var(--color-green-dim);
  }
  .mod-card.type--mod {
    border-left: 3px solid var(--color-amber-dim);
  }

  /* ── Header ── */
  .mod-card__header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .mod-card__title-block {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .mod-card__badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    padding: 2px 6px;
    border-radius: var(--rb-radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .mod-card__badge.type--song {
    background: color-mix(in srgb, var(--color-green-dim) 20%, transparent);
    color: var(--color-green);
    border: 1px solid var(--color-green-dim);
  }

  .mod-card__badge.type--mod {
    background: color-mix(in srgb, var(--color-amber-dim) 20%, transparent);
    color: var(--color-amber);
    border: 1px solid var(--color-amber-dim);
  }

  .mod-card__badge.type--other {
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .mod-card__title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text);
    margin: 0;
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
  }

  .mod-card__host-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 1.5rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid rgba(255, 176, 0, 0.2);
    border-radius: 999px;
    background: rgba(255, 176, 0, 0.08);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-amber);
  }

  .mod-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 0.75rem;
    margin: 0;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--rb-radius);
    background: rgba(0, 0, 0, 0.16);
  }

  .mod-card__meta-row {
    min-width: 0;
  }

  .mod-card__meta dt {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mod-card__meta dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  /* ── Body ── */
  .mod-card__desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* ── Footer ── */
  .mod-card__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .mod-card__author {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .mod-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .mod-card__tag {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--rb-radius-sm);
    padding: 1px 5px;
    color: var(--color-text-muted);
  }

  .mod-card__tag-link {
    text-decoration: none;
    min-height: 1.8rem;
    align-items: center;
  }

  .mod-card__tag-link:hover,
  .mod-card__tag-link:focus-visible {
    color: var(--color-amber);
    border-color: var(--color-amber-dim);
  }

  .mod-card__actions {
    margin-left: auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .mod-card__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.55rem 0.8rem;
    border-radius: var(--rb-radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    color: var(--color-text);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .mod-card__action--preview {
    cursor: pointer;
  }

  .mod-card__action--primary {
    color: var(--color-amber);
  }

  .mod-card__action--secondary {
    color: var(--color-green);
  }

  .mod-card__action:hover,
  .mod-card__action:focus-visible {
    color: var(--color-green);
    border-color: var(--color-amber-dim);
    background: rgba(255, 176, 0, 0.06);
  }

  @media (max-width: 767px) {
    .mod-card {
      padding: 0.75rem;
      gap: 0.5rem;
    }

    .mod-card__meta {
      grid-template-columns: 1fr;
      padding: 0.5rem;
      gap: 0.3rem;
    }

    .mod-card__actions {
      width: 100%;
      margin-left: 0;
      justify-content: stretch;
    }

    .mod-card__action {
      flex: 1 1 100%;
      min-height: 44px;
    }

    .mod-card__action .external-link__host {
      display: none;
    }

    .mod-card__desc {
      font-size: 0.82rem;
    }
  }
</style>
