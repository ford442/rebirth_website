---
// RbsPlayer.astro — In-browser .rbs preview player (WASM-backed)
//
// Retro-hardware UI that wraps the WasmAudioBridge.
// Supports drag-and-drop .rbs files, transport controls, and a
// mini 16-step LED bar that visualises playback position.
//
// Usage:
//   <RbsPlayer title="BROWSER PLAYBACK ENGINE" />

import HardwarePanel from './ui/HardwarePanel.astro';
import Led from './ui/Led.astro';
import Lcd from './ui/Lcd.astro';

export interface Props {
  /** Optional initial .rbs file URL */
  src?: string;
  /** Auto-play once loaded */
  autoplay?: boolean;
  /** Panel title */
  title?: string;
}

const { src, autoplay = false, title = 'BROWSER PLAYBACK ENGINE' } = Astro.props;

// LED status derived from props
const hasSrc = !!src;
---

<HardwarePanel
  ariaLabelledBy="wasm-heading"
  variant="rackmount-module"
  animate
  title={title}
>
  <div class="rbs-player" data-autoplay={String(autoplay)} data-src={src ?? ''}>

    <!-- Status row: LCDs + LED -->
    <div class="player-status-row">
      <Lcd label="STATUS" value="IDLE" size="sm" class="player-lcd-status" />
      <Lcd label="BPM" value="---" size="sm" class="player-lcd-bpm" />
      <Lcd label="BAR" value="--" size="sm" class="player-lcd-bar" />
      <Led status="pending" label="WASM PENDING" class="player-led" />
    </div>

    <!-- Drop zone / file input -->
    <div class="player-dropzone" id="rbsDropZone">
      <span class="dropzone-icon" aria-hidden="true">📂</span>
      <p class="dropzone-text">
        {hasSrc
          ? 'Click Play to preview, or drop another .rbs file here'
          : 'Drop an .rbs file here, or click to browse'}
      </p>
      <input
        type="file"
        accept=".rbs"
        id="rbsFileInput"
        class="dropzone-input"
        aria-label="Select .rbs file"
      />
    </div>

    <!-- Song metadata display -->
    <div class="player-meta is-hidden" id="rbsMeta">
      <span class="meta-title" id="rbsMetaTitle">—</span>
      <span class="meta-author" id="rbsMetaAuthor">—</span>
    </div>

    <!-- Mini 16-step sequencer visualiser -->
    <div class="player-stepbar" aria-label="Step sequencer visualiser" role="img">
      {Array.from({ length: 16 }, (_, i) => (
        <span
          class={`step-dot${i % 4 === 0 ? ' step-dot--beat' : ''}`}
          data-step={i}
          aria-hidden="true"
        />
      ))}
    </div>

    <!-- Transport controls -->
    <nav class="player-transport" aria-label="Playback transport controls">
      <button
        class="rb-transport-btn rb-transport-btn--play"
        id="rbsBtnPlay"
        type="button"
        aria-label="Play"
        title="Play"
        disabled
      >▶</button>
      <button
        class="rb-transport-btn"
        id="rbsBtnStop"
        type="button"
        aria-label="Stop"
        title="Stop"
        disabled
      >■</button>
      <button
        class="rb-transport-btn rb-transport-btn--rec"
        id="rbsBtnLoad"
        type="button"
        aria-label="Load file"
        title="Load file"
      >●</button>
    </nav>

    <!-- Error / fallback message -->
    <div class="player-fallback is-hidden" id="rbsFallback">
      <p>Your browser doesn't support the in-browser player.</p>
      <p>
        <a href="https://www.rebirthmuseum.com/" rel="noopener noreferrer" target="_blank">
          Download ReBirth RB-338 (free abandonware) →
        </a>
      </p>
    </div>
  </div>
</HardwarePanel>

<style>
  .rbs-player {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Status row */
  .player-status-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .player-lcd-status { flex: 1 1 80px; }
  .player-lcd-bpm    { flex: 1 1 60px; }
  .player-lcd-bar    { flex: 1 1 60px; }
  .player-led        { margin-left: auto; }

  /* Drop zone */
  .player-dropzone {
    border: 2px dashed var(--rb-border, #3a3a3a);
    border-radius: 6px;
    padding: 1.5rem 1rem;
    text-align: center;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease;
    position: relative;
  }

  .player-dropzone:hover,
  .player-dropzone.drag-over {
    border-color: var(--rb-amber, #ffb000);
    background: rgba(255, 176, 0, 0.04);
  }

  .dropzone-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
    opacity: 0.6;
  }

  .dropzone-text {
    margin: 0;
    font-size: 0.85rem;
    color: var(--rb-silver-dim, #888);
    font-family: var(--rb-font-display, 'Courier New', monospace);
  }

  .dropzone-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  /* Metadata strip */
  .player-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    border: 1px solid var(--rb-border, #3a3a3a);
  }

  .meta-title {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.9rem;
    color: var(--rb-amber, #ffb000);
    letter-spacing: 0.05em;
  }

  .meta-author {
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    color: var(--rb-silver-dim, #888);
  }

  /* Step bar */
  .player-stepbar {
    display: flex;
    gap: 0.35rem;
    justify-content: center;
    flex-wrap: wrap;
    padding: 0.5rem;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
    border: 1px solid var(--rb-border, #3a3a3a);
  }

  .step-dot {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    border-radius: 2px;
    background: linear-gradient(180deg, #3a3a3a 0%, #2a2a2a 100%);
    border: 1px solid #444;
    transition: background 80ms ease, box-shadow 80ms ease;
  }

  .step-dot--beat {
    border-color: var(--rb-red-dim, #8a1528);
  }

  .step-dot.is-active {
    background: linear-gradient(180deg, var(--rb-amber, #ffb000) 0%, #a07800 100%);
    border-color: var(--rb-amber-dim, #b37800);
    box-shadow: 0 0 6px rgba(255, 176, 0, 0.4);
  }

  .step-dot.is-current {
    background: linear-gradient(180deg, var(--rb-green, #39ff14) 0%, #1a7a33 100%);
    border-color: var(--rb-green-dim, #1a5230);
    box-shadow: 0 0 6px rgba(57, 255, 20, 0.4);
  }

  /* Transport */
  .player-transport {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }

  .player-transport .rb-transport-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Fallback message */
  .player-fallback {
    text-align: center;
    padding: 1rem;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.85rem;
    color: var(--rb-silver-dim, #888);
  }

  .player-fallback a {
    color: var(--rb-amber, #ffb000);
  }

  @media (max-width: 480px) {
    .player-stepbar {
      gap: 0.25rem;
      padding: 0.35rem;
    }

    .step-dot {
      width: 8px;
      height: 8px;
    }

    .player-status-row {
      justify-content: center;
    }

    .player-led {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }

    .player-dropzone {
      padding: 1.25rem 0.75rem;
    }

    .dropzone-text {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  import { WasmAudioBridge } from '../wasm/js/WasmAudioBridge';
  import type { PlayerStatus } from '../wasm/types/wasm-audio';

  (async function initRbsPlayer() {
    const playerEl = document.querySelector('.rbs-player') as HTMLElement | null;
    if (!playerEl) return;

    const dropZone = document.getElementById('rbsDropZone') as HTMLElement | null;
    const fileInput = document.getElementById('rbsFileInput') as HTMLInputElement | null;
    const btnPlay = document.getElementById('rbsBtnPlay') as HTMLButtonElement | null;
    const btnStop = document.getElementById('rbsBtnStop') as HTMLButtonElement | null;
    const btnLoad = document.getElementById('rbsBtnLoad') as HTMLButtonElement | null;
    const metaEl = document.getElementById('rbsMeta') as HTMLElement | null;
    const metaTitle = document.getElementById('rbsMetaTitle') as HTMLElement | null;
    const metaAuthor = document.getElementById('rbsMetaAuthor') as HTMLElement | null;
    const fallbackEl = document.getElementById('rbsFallback') as HTMLElement | null;
    const lcdStatus = playerEl.querySelector('.player-lcd-status .lcd-value') as HTMLElement | null;
    const lcdBpm = playerEl.querySelector('.player-lcd-bpm .lcd-value') as HTMLElement | null;
    const lcdBar = playerEl.querySelector('.player-lcd-bar .lcd-value') as HTMLElement | null;
    const ledLabel = playerEl.querySelector('.player-led') as HTMLElement | null;
    const stepDots = playerEl.querySelectorAll('.step-dot');

    const bridge = new WasmAudioBridge();

    // ── Status updates ──────────────────────────────────────────────

    function setStatus(status: PlayerStatus) {
      if (!lcdStatus || !ledLabel) return;

      const labelText = ledLabel.querySelector('.rb-led__label');

      switch (status) {
        case 'idle':
          lcdStatus.textContent = 'IDLE';
          ledLabel.className = 'rb-led rb-led--pending player-led';
          if (labelText) labelText.textContent = 'PENDING';
          break;
        case 'loading':
          lcdStatus.textContent = 'LOAD…';
          ledLabel.className = 'rb-led rb-led--pending player-led';
          if (labelText) labelText.textContent = 'LOADING';
          break;
        case 'ready':
          lcdStatus.textContent = 'READY';
          ledLabel.className = 'rb-led rb-led--online player-led';
          if (labelText) labelText.textContent = 'ONLINE';
          if (btnPlay) btnPlay.disabled = false;
          if (btnStop) btnStop.disabled = false;
          break;
        case 'playing':
          lcdStatus.textContent = 'PLAY';
          ledLabel.className = 'rb-led rb-led--online player-led';
          if (labelText) labelText.textContent = 'PLAYING';
          break;
        case 'error':
          lcdStatus.textContent = 'ERR';
          ledLabel.className = 'rb-led rb-led--offline player-led';
          if (labelText) labelText.textContent = 'ERROR';
          break;
      }
    }

    bridge.setStatusCallback(setStatus);

    // ── Position updates ────────────────────────────────────────────

    bridge.setPositionCallback((bar, step) => {
      if (lcdBar) lcdBar.textContent = String(bar).padStart(2, '0');
      stepDots.forEach((dot, i) => {
        dot.classList.toggle('is-current', i === step);
      });
    });

    // ── File handling ───────────────────────────────────────────────

    async function loadFile(buffer: ArrayBuffer) {
      try {
        const song = await bridge.loadRbsFile(buffer);
        if (metaTitle) metaTitle.textContent = song.title || 'Untitled';
        if (metaAuthor) metaAuthor.textContent = song.author || 'Unknown';
        if (metaEl) metaEl.classList.remove('is-hidden');
        if (lcdBpm) lcdBpm.textContent = String(Math.round(song.bpm));
        if (lcdBar) lcdBar.textContent = '01';
      } catch (err) {
        console.error('Failed to load .rbs:', err);
        alert('Failed to parse .rbs file. See console for details.');
      }
    }

    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;
        file.arrayBuffer().then(loadFile);
      });
    }

    // Drag & drop
    if (dropZone) {
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('drag-over');
      });
      dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('drag-over');
      });
      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-over');
        const file = e.dataTransfer?.files[0];
        if (file && file.name.endsWith('.rbs')) {
          file.arrayBuffer().then(loadFile);
        }
      });
    }

    // ── Transport buttons ───────────────────────────────────────────

    btnPlay?.addEventListener('click', () => {
      if (bridge.playerStatus === 'playing') {
        bridge.pause();
      } else {
        bridge.play();
      }
    });

    btnStop?.addEventListener('click', () => {
      bridge.stop();
    });

    btnLoad?.addEventListener('click', () => {
      fileInput?.click();
    });

    // ── Init ────────────────────────────────────────────────────────

    try {
      await bridge.init();

      const autoplay = playerEl.dataset.autoplay === 'true';
      const srcUrl = playerEl.dataset.src;

      if (srcUrl) {
        const res = await fetch(srcUrl);
        const buf = await res.arrayBuffer();
        await loadFile(buf);
        if (autoplay) bridge.play();
      }
    } catch (err) {
      console.error('WASM init failed:', err);
      fallbackEl?.classList.remove('is-hidden');
      dropZone?.classList.add('is-hidden');
      if (btnPlay) btnPlay.disabled = true;
      if (btnStop) btnStop.disabled = true;
    }
  })();
</script>
