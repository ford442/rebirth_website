---
import type { LcdProps } from './types';

interface Props extends LcdProps {}

const { label, value, unit, size = 'default', ariaLabel, class: className = '' } = Astro.props;
---

<div class={`rb-lcd ${className}`.trim()} aria-label={ariaLabel ?? `${label}: ${value}${unit ?? ''}`}>
  <div class="lcd-label">{label}</div>
  <div class={`lcd-value${size === 'sm' ? ' lcd-value--sm' : ''}`}>
    {value}{unit && <span class="lcd-unit">{unit}</span>}
  </div>
</div>
