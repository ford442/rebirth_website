---
import ScrewCorners from './ScrewCorners.astro';
import PanelHeader from './PanelHeader.astro';
import type { HardwarePanelProps } from './types';

interface Props extends HardwarePanelProps {}

const {
  tag: Tag = 'section',
  ariaLabel,
  ariaLabelledBy,
  title,
  ledStatus,
  ledLabel,
  variant = 'default',
  animate = false,
  screws = true,
  screwCross = false,
  class: className = '',
  headerClass = '',
  bodyClass = '',
} = Astro.props;

/* rackmount variants use a completely different visual system */
const rackmountVariants = ['rackmount', 'rackmount-module', 'rackmount-chassis'];
const isRackmount = rackmountVariants.includes(variant);

const variantClass = variant === 'default' ? '' : `rb-panel--${variant}`;
const rackClass = isRackmount ? `rb-rack rb-rack--${variant.replace('rackmount-', '')}` : '';
const animateClass = animate ? 'rb-panel--animate' : '';
---

<Tag
  class={`${isRackmount ? rackClass : 'rb-panel'} ${!isRackmount ? variantClass : ''} ${animateClass} ${className}`.trim()}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledBy}
>
  {isRackmount && (
    <>
      <span class="rb-rack__ear rb-rack__ear--left" aria-hidden="true"></span>
      <span class="rb-rack__ear rb-rack__ear--right" aria-hidden="true"></span>
    </>
  )}

  {screws && !isRackmount && <ScrewCorners cross={screwCross} />}
  {screws && isRackmount && <ScrewCorners cross={true} />}

  {title && !isRackmount && (
    <PanelHeader title={title} ledStatus={ledStatus} ledLabel={ledLabel} class={headerClass}>
      <slot name="header-extra" />
    </PanelHeader>
  )}

  {title && isRackmount && (
    <div class={`rb-rack__header ${headerClass}`.trim()}>
      <span class="rb-panel__title">{title}</span>
      {ledStatus && ledLabel ? (
        <span class={`rb-led rb-led--${ledStatus}`} aria-hidden="true">
          <span class="rb-led__dot"></span>
          <span class="rb-led__label">{ledLabel}</span>
        </span>
      ) : null}
      <slot name="header-extra" />
    </div>
  )}

  <slot name="header" />

  <div class={`${isRackmount ? 'rb-rack__body' : 'rb-panel__body'} ${bodyClass}`.trim()}>
    <slot />
  </div>
</Tag>
