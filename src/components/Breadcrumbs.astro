---
// Breadcrumbs.astro — hardware-styled breadcrumb navigation with JSON-LD
import { normalizeBase } from '../lib/url';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  jsonLd?: boolean;
}

const { items, jsonLd = true } = Astro.props;
const base = normalizeBase(import.meta.env.BASE_URL);

const resolvedItems = items.map((item) => {
  if (!item.href) return item;
  if (item.href.startsWith(base)) return item;
  if (item.href.startsWith('/')) return { ...item, href: `${base}${item.href}` };
  return item;
});

const schema = jsonLd
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: resolvedItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: item.href ? `${Astro.site?.origin ?? ''}${item.href}` : undefined,
      })),
    }
  : null;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
  <ol class="breadcrumbs__list" role="list">
    {resolvedItems.map((item, index) => {
      const isLast = index === resolvedItems.length - 1;
      return (
        <li
          class={`breadcrumbs__item ${isLast ? 'breadcrumbs__item--current' : ''}`}
          {...(isLast ? { 'aria-current': 'page' } : {})}
        >
          {isLast || !item.href ? (
            <span class="breadcrumbs__current">{item.label}</span>
          ) : (
            <a class="breadcrumbs__link" href={item.href}>
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.25rem;
    font-family: var(--rb-font-display, 'Courier New', monospace);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rb-silver-dim, #888);
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 24px;
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: '›';
    color: var(--rb-amber-dim, #b37800);
    font-size: 0.9em;
  }

  .breadcrumbs__link {
    color: var(--rb-silver-dim, #888);
    text-decoration: none;
    transition: color 120ms ease, text-decoration-color 120ms ease;
  }

  .breadcrumbs__link:hover,
  .breadcrumbs__link:focus-visible {
    color: var(--rb-amber, #ffb000);
    text-decoration: underline;
    text-decoration-color: var(--rb-amber-dim, #b37800);
    outline: none;
  }

  .breadcrumbs__current {
    color: var(--rb-amber, #ffb000);
  }

  @media (max-width: 480px) {
    .breadcrumbs__list {
      gap: 0.25rem 0.4rem;
    }

    .breadcrumbs__item {
      font-size: 0.7rem;
    }
  }
</style>
